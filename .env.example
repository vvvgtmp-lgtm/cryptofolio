# ============================================================
# CryptoFolio configuration. Copy to .env:  cp .env.example .env
# Every service reads ONLY environment variables (12-factor).
# ============================================================

# ---- General ----
# COMPOSE_PROJECT_NAME=cryptofolio   # optional; NOTE: it would also override the name of docker-compose.test.yml
# Image names: CI pushes <IMAGE_REGISTRY>/<service>:<IMAGE_TAG>
# (e.g. europe-docker.pkg.dev/<project>/cryptofolio and a git SHA)
IMAGE_REGISTRY=cryptofolio
IMAGE_TAG=local
APP_ENV=local
LOG_LEVEL=info
# Host port of the gateway (the only published port).
GATEWAY_PORT=80

# ---- Postgres ----
POSTGRES_USER=cryptofolio
POSTGRES_PASSWORD=cryptofolio
POSTGRES_DB=cryptofolio
DATABASE_URL=postgres://cryptofolio:cryptofolio@postgres:5432/cryptofolio

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Object storage (MinIO locally; GCS via S3 interoperability later) ----
S3_ENDPOINT=http://minio:9000
# URL the BROWSER uses for presigned links. Must match how users reach the gateway
# (include the port if GATEWAY_PORT is not 80, e.g. http://localhost:8080).
S3_PUBLIC_ENDPOINT=http://localhost
S3_REGION=us-east-1
S3_ACCESS_KEY=cryptofolio
S3_SECRET_KEY=cryptofolio-secret
S3_BUCKET_AVATARS=cf-avatars
S3_BUCKET_IMPORTS=cf-imports
S3_BUCKET_EXPORTS=cf-exports

# ---- api ----
# Must be >= 32 chars and different from each other. "change-me" values are refused unless APP_ENV=local.
# Generate real ones with:  openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-local-dev-access-secret-00000
JWT_REFRESH_SECRET=change-me-local-dev-refresh-secret-0000
COOKIE_SECURE=false
PRICE_SERVICE_URL=http://price-service:8000
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_MINUTE=10
# Reverse proxies in front of the api whose X-Forwarded-For entry is trusted (gateway=1; GCP LB + gateway=2)
TRUST_PROXY_HOPS=1
JOBS_STREAM=jobs
# migrate container: insert demo user + sample data
SEED_DEMO_DATA=true

# ---- price-service ----
# mock      = offline, deterministic simulated prices (classroom default)
# binance   = real prices from Binance public market data: no API key, no quota, 20 coins
# coingecko = real prices, top 100 coins with logos; keyless access is limited to
#             ~5-15 calls/min, so set a free CoinGecko "Demo" key in COINGECKO_API_KEY
PRICE_PROVIDER=mock
BINANCE_BASE_URL=https://data-api.binance.vision
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# ---- worker ----
ALERT_CHECK_INTERVAL_SECONDS=60
